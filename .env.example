# --- Telegram Bot (notifications + purchase confirmation) ---
# Create the bot via @BotFather on Telegram, copy the token below.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# Your numeric chat_id (see README for how to find it).
TELEGRAM_CHAT_ID=123456789

# --- Purchase behavior ---
# DRY_RUN=true runs everything except the final order-confirmation click.
DRY_RUN=true
# Maximum accepted price in EUR. If the page shows a higher price -> no purchase.
MAX_PRICE_EUR=6.00
# Hours to wait for the Telegram confirmation button before aborting.
CONFIRM_TIMEOUT_HOURS=6
# getUpdates polling interval (seconds). 25 is the max reliable long-poll.
CONFIRM_POLL_SECONDS=25

# --- Optional overrides ---
# Force a specific volume (default: read from state.json and increment by 1).
# TARGET_VOLUME=64
# Override the series name in the search (default below).
SEARCH_QUERY_TEMPLATE=One Piece New Edition vol. {volume}
